{
  "name": "paylet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --no-warnings --env-file-if-exists=.env --watch --import tsx src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --no-warnings --env-file-if-exists=.env --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test e2e/judge-flow.spec.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "verify:drop": "tsx scripts/verify-drop.ts",
    "evals:dataset": "node --no-warnings --env-file-if-exists=.env --import tsx scripts/build-dataset.ts",
    "evals": "node --no-warnings --env-file-if-exists=.env --import tsx scripts/run-evals.ts",
    "screens": "tsx scripts/screens.ts",
    "e2e:real": "playwright test e2e/real-paypal.spec.ts",
    "test:coverage": "vitest run --coverage",
    "badges": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json && node .github/scripts/badges.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "2.4.0",
    "@paypal/paypal-js": "^11.3.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.5.1"
}
