# PayPal SANDBOX REST app (never live credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id; if empty and PUBLIC_URL is https, Paylet registers one on boot
PAYPAL_WEBHOOK_ID=

# Any OpenAI-compatible chat endpoint (we use Xiaomi MiMo V2.6 Pro via Primalabs)
AI_BASE_URL=https://api.primalabs.ai/v1
AI_MODEL=primalabs-ai/MiMo-V2.6-Pro
AI_API_KEY=
# Hard cap on LLM calls per UTC day (protects the public demo)
AI_DAILY_CALL_LIMIT=600

PUBLIC_URL=http://localhost:8787
PORT=8787
DATA_DIR=./data
# Secret used to HMAC payer ids / emails (identity is never stored in clear)
HASH_SECRET=change-me
